NEXTAUTH_SECRET="your-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"
DATABASE_URL="postgresql://..."

# Cloudflare R2 Object Storage (Free 10GB for dish & category images)
# Find these in Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
CLOUDFLARE_R2_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET_NAME="rrb-pos-images"
# Custom domain (e.g. https://images.yourdomain.com) or Cloudflare r2.dev public URL (e.g. https://pub-xxx.r2.dev)
CLOUDFLARE_R2_PUBLIC_URL=""
